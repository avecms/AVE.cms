<label class="product-package-field product-package-field-title"><span>Грузовое место</span><input class="input" name="title" value="{{ package.title|default('')|e('html_attr') }}" placeholder="Коробка 1" aria-label="Название грузового места"></label>
<label class="product-package-field"><span>Количество</span><input class="input" type="number" name="quantity" min="1" max="999" step="1" value="{{ package.quantity }}" aria-label="Количество"></label>
<label class="product-package-field"><span>Вес, кг</span><input class="input" type="number" name="weight_kg" min="0" step="0.001" value="{{ package.weight_kg|default('') }}" placeholder="0" aria-label="Вес в килограммах"></label>
<label class="product-package-field"><span>Длина, см</span><input class="input" type="number" name="length_cm" min="0" step="0.1" value="{{ package.length_cm|default('') }}" placeholder="0" aria-label="Длина в сантиметрах"></label>
<label class="product-package-field"><span>Ширина, см</span><input class="input" type="number" name="width_cm" min="0" step="0.1" value="{{ package.width_cm|default('') }}" placeholder="0" aria-label="Ширина в сантиметрах"></label>
<label class="product-package-field"><span>Высота, см</span><input class="input" type="number" name="height_cm" min="0" step="0.1" value="{{ package.height_cm|default('') }}" placeholder="0" aria-label="Высота в сантиметрах"></label>
