<div class="static_page system-public-auth">
  <div class="page_title"><div class="page_title_inner"><h1 class="page_title_heading">{{ page.title }}</h1></div></div>
  <div class="static_page_inner">
    {% if page.description %}<p class="text-muted">{{ page.description }}</p>{% endif %}
    {% if errors._form %}<div class="alert alert-danger" role="alert">{{ errors._form }}</div>{% endif %}
    {% if email_registration_enabled %}
    <form method="post" action="{{ base }}{{ auth_urls.register }}" class="system-public-auth-form" data-auth-register>
      <input type="hidden" name="_csrf" value="{{ csrf|e }}">
      <div class="form-row">
        <div class="form-group col-md-6"><label for="register-firstname">Имя</label><input class="form-control" id="register-firstname" name="firstname" value="{{ values.firstname|default('')|e }}" autocomplete="given-name" {{ config.require_firstname ? 'required' : '' }}>{% if errors.firstname %}<small class="text-danger">{{ errors.firstname }}</small>{% endif %}</div>
        {% if config.show_lastname %}<div class="form-group col-md-6"><label for="register-lastname">Фамилия</label><input class="form-control" id="register-lastname" name="lastname" value="{{ values.lastname|default('')|e }}" autocomplete="family-name" {{ config.require_lastname ? 'required' : '' }}>{% if errors.lastname %}<small class="text-danger">{{ errors.lastname }}</small>{% endif %}</div>{% endif %}
      </div>
      {% if config.show_phone or config.show_company %}<div class="form-row">
        {% if config.show_phone %}<div class="form-group col-md-6"><label for="register-phone">Телефон</label><input class="form-control" id="register-phone" type="tel" name="phone" value="{{ values.phone|default('')|e }}" autocomplete="tel" inputmode="tel" placeholder="+7 (000) 000-00-00" maxlength="18" data-phone-mask {{ config.require_phone ? 'required' : '' }}>{% if errors.phone %}<small class="text-danger">{{ errors.phone }}</small>{% endif %}</div>{% endif %}
        {% if config.show_company %}<div class="form-group col-md-6"><label for="register-company">Компания</label><input class="form-control" id="register-company" name="company" value="{{ values.company|default('')|e }}" autocomplete="organization" {{ config.require_company ? 'required' : '' }}>{% if errors.company %}<small class="text-danger">{{ errors.company }}</small>{% endif %}</div>{% endif %}
      </div>{% endif %}
      <div class="form-group"><label for="register-email">Email</label><input class="form-control" id="register-email" type="email" name="email" value="{{ values.email|default('')|e }}" autocomplete="email" required>{% if errors.email %}<small class="text-danger">{{ errors.email }}</small>{% endif %}</div>
      {% if fields %}<h2 class="h4 system-public-auth-section-title">Дополнительные данные</h2>{% endif %}
      <div class="form-row">{% for field in fields %}<div class="form-group col-md-6">{% if field.type == 'checkbox' %}<div class="form-check"><input class="form-check-input" id="register-extra-{{ field.id }}" type="checkbox" name="extra[{{ field.id }}]" value="1" {{ extra_values[field.id] == '1' ? 'checked' : '' }} {{ field.is_required ? 'required' : '' }}><label class="form-check-label" for="register-extra-{{ field.id }}">{{ field.name }}</label></div>{% else %}<label for="register-extra-{{ field.id }}">{{ field.name }}</label>{% if field.type == 'textarea' %}<textarea class="form-control" id="register-extra-{{ field.id }}" name="extra[{{ field.id }}]" rows="4" {{ field.is_required ? 'required' : '' }}>{{ extra_values[field.id]|default('')|e }}</textarea>{% elseif field.type == 'select' %}<select class="form-control" id="register-extra-{{ field.id }}" name="extra[{{ field.id }}]" {{ field.is_required ? 'required' : '' }}><option value="">Не выбрано</option>{% for choice in field.choices %}<option value="{{ choice|e }}" {{ extra_values[field.id] == choice ? 'selected' : '' }}>{{ choice }}</option>{% endfor %}</select>{% else %}<input class="form-control" id="register-extra-{{ field.id }}" type="{{ field.type in ['date','number','email','tel'] ? field.type : 'text' }}" name="extra[{{ field.id }}]" value="{{ extra_values[field.id]|default('')|e }}" {{ field.is_required ? 'required' : '' }}>{% endif %}{% endif %}{% if errors['extra_' ~ field.id] %}<small class="text-danger">{{ errors['extra_' ~ field.id] }}</small>{% endif %}</div>{% endfor %}</div>
      <div class="form-row"><div class="form-group col-md-6"><label for="register-password">Пароль</label><input class="form-control" id="register-password" type="password" name="password" autocomplete="new-password" minlength="{{ config.password_min_length }}" required>{% if errors.password %}<small class="text-danger">{{ errors.password }}</small>{% endif %}</div><div class="form-group col-md-6"><label for="register-password-confirm">Повторите пароль</label><input class="form-control" id="register-password-confirm" type="password" name="password_confirm" autocomplete="new-password" required>{% if errors.password_confirm %}<small class="text-danger">{{ errors.password_confirm }}</small>{% endif %}</div></div>
      <div class="system-public-auth-actions"><button class="btn btn-primary" type="submit">{{ page.submit_label }}</button><a href="{{ base }}{{ auth_urls.login }}">Уже есть аккаунт</a></div>
    </form>
    {% endif %}
    {% if phone_registration_enabled and registration_phone_providers %}
      {% include '@system_auth/phone.twig' with {'phone_providers': registration_phone_providers, 'phone_auth_registration': true, 'return_url': auth_urls.profile} %}
    {% endif %}
    {% if not email_registration_enabled and not (phone_registration_enabled and registration_phone_providers) %}
    <p role="status" data-auth-unavailable>Регистрация сейчас недоступна.</p>
    {% endif %}
  </div>
</div>
